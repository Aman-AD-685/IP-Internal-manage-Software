# Supabase Configuration
# Copy this file to .env and fill in your values from Supabase Dashboard → Settings → API

# Project URL
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co

# Service Role Key (REQUIRED - has admin permissions)
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key_here

# Anon Key (REQUIRED for login - use the JWT format eyJ... from anon public)
SUPABASE_ANON_KEY=your_anon_public_jwt_here

# Database URL (REQUIRED for automatic migrations)
# Get from: Supabase Dashboard → Settings → Database → Connection string → URI
# Use "Transaction" mode, replace [YOUR-PASSWORD] with your database password
SUPABASE_DB_URL=postgresql://postgres.[PROJECT_REF]:[YOUR-PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres

# JWT validation (replace YOUR_PROJECT_REF with your project ID from the URL)
JWT_AUDIENCE=authenticated
JWT_ISSUER=https://YOUR_PROJECT_REF.supabase.co/auth/v1

# Frontend URL - used for email confirmation redirect after user clicks link
# Local: http://localhost:3000  Production: https://ip-internal-manage-software.vercel.app
FRONTEND_URL=http://localhost:3000

# Public backend URL for email Approve/Reject links (fast HTML, no login).
# Local: http://127.0.0.1:8020
# Production (Render): https://ip-internal-manage-software.onrender.com
# If unset on Render, app uses RENDER_EXTERNAL_URL or the production fallback above.
PUBLIC_API_URL=http://127.0.0.1:8020

# CORS (required for production): comma-separated frontend origins
# Backend also reads CORS_ORIGIN, CORS_ORIGIN_1, CORS_ORIGIN_2, ... CORS_ORIGIN_10 (Render-style)
# industryprime.vercel.app is included in default production list
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,https://industryprime.vercel.app,https://ip-internal-manage-software.vercel.app

# ---------------------------------------------------------------------------
# Outgoing email (checklist / delegation reminders, etc.)
# send_email() order: SendGrid API → SMTP (see app/utils/email.py)
# ---------------------------------------------------------------------------

# Sender shown in emails (must match an address verified at your provider)
SMTP_FROM_EMAIL=noreply@your-verified-domain.com

# --- EMAIL PROVIDER (pick one) ---
#
# A) Postmark — SMTP, strong deliverability
#    Create a Server API token in Postmark and verify SMTP_FROM_EMAIL as a sender/signature.
#    Easiest setup:
# SMTP_HOST=smtp.postmarkapp.com
# SMTP_PORT=587
# SMTP_USER=your_postmark_server_token
# SMTP_PASSWORD=your_postmark_server_token
# SMTP_FROM_EMAIL=noreply@your-verified-domain.com
#
#    Or use the app's Postmark aliases:
# POSTMARK_SERVER_TOKEN=your_postmark_server_token
# POSTMARK_FROM_EMAIL=noreply@your-verified-domain.com
#
# B) Brevo (ex-Sendinblue) — ~300 emails/day free, SMTP, good for India/global
#    Sign up: https://www.brevo.com → Settings → SMTP & API → generate SMTP key
#    Verify a sender email (or domain) under Senders & IP.
# SMTP_HOST=smtp-relay.brevo.com
# SMTP_PORT=587
# SMTP_USER=your_brevo_login_email@example.com
# SMTP_PASSWORD=your_brevo_smtp_key
#
# C) SendGrid — ~100 emails/day free, HTTP API (works on Render without SMTP ports)
#    https://signup.sendgrid.com → API Keys → Create key → Sender Authentication
# SENDGRID_API_KEY=SG.xxxxxxxxxxxx
# SENDGRID_FROM_EMAIL=same-as-verified-sender@yourdomain.com
# SENDGRID_FROM_NAME=IP Internal Management
#
# D) Resend — generous free tier, SMTP: smtp.resend.com:587, user "resend", password=API key
#
# E) Gmail — free but low volume; Google Account → App passwords → SMTP:
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=you@gmail.com
# SMTP_PASSWORD=16_char_app_password

# Postmark SMTP (recommended) — Server API token as password; optional PM-T-outbound-* username
# POSTMARK_SMTP_HOST=smtp.postmarkapp.com
# POSTMARK_SMTP_PORT=587
# POSTMARK_SMTP_USERNAME=PM-T-outbound-...   # optional message stream (SMTP auth)
# SMTP_POSTMARK_STREAM=outbound              # Render alias — stream name OR PM-T-outbound-* username
# POSTMARK_SMTP_TOKEN=your-server-api-token  # also POSTMARK_SERVER_TOKEN / POSTMARK_API_TOKEN
# POSTMARK_FROM_EMAIL=verified@yourdomain.com
# POSTMARK_SERVER_TOKEN=   # alias for POSTMARK_SMTP_TOKEN (API or SMTP auth)

# Generic SMTP (local dev or any provider; on Render, try SMTP_PORT=2525 if 587 fails)
# SMTP_HOST=smtp-relay.brevo.com
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASSWORD=
# SMTP_PASS=   # alias for SMTP_PASSWORD
# SMTP_FROM_EMAIL=
# EMAIL_USE_SMTP=1   # force SMTP even if SENDGRID_API_KEY is set
# EMAIL_PROVIDER=postmark   # use Postmark when both Brevo SMTP_* and POSTMARK_* are in .env
# EMAIL_MODE=postmark       # postmark = send | log = dry-run (no SMTP)
# EMAIL_SMTP_FALLBACK=1     # optional on Render; local dev auto-falls back to SMTP on API 401 when PM-T user is set
# EMAIL_TEST_REDIRECT=you@example.com   # all outbound mail to one inbox (dev)
# FRONTEND_URL=https://your-app.vercel.app   # links in notification HTML

# (Optional) SendGrid — leave unset if using SMTP only
# SENDGRID_API_KEY=
# SENDGRID_FROM_EMAIL=
# SENDGRID_FROM_NAME=
# One-off SMTP test: POST /api/smtp/test with header X-SMTP-Test-Secret (must match) and optional JSON {"to":"..."}
# Or run:  cd backend && python scripts/test_smtp.py your@email.com
SMTP_TEST_SECRET=

# Secret for cron to call POST /checklist/send-daily-reminders (set X-Cron-Secret header)
CHECKLIST_CRON_SECRET=
# Optional: separate secret for delegation reminders. Falls back to CHECKLIST_CRON_SECRET if not set.
# DELEGATION_CRON_SECRET=

# ---------------------------------------------------------------------------
# Delegation integration API (Claude / scripts — no FMS login)
# Header: X-FMS-Integration-Key: <same value>
# Endpoints:
#   POST /api/integrations/delegation/tasks
#   GET  /api/integrations/delegation/users
# Generate a key: python -c "import secrets; print(secrets.token_urlsafe(32))"
# Paste the same value on Render + Claude Project secret. Do not commit the real key.
# ---------------------------------------------------------------------------
DELEGATION_INTEGRATION_API_KEY=
# Optional: user_profiles.id used as created_by for integration inserts (defaults to assignee)
# DELEGATION_INTEGRATION_ACTOR_ID=

# Postmark (production on Render)
# Option A (best): Server API Token for HTTP API
# POSTMARK_SERVER_TOKEN=   # Postmark → Servers → API Tokens (NOT the PM-T- SMTP username)
# POSTMARK_FROM_EMAIL=     # verified sender in Postmark
# Option B: SMTP only (works on Render when API token missing or invalid)
# POSTMARK_SMTP_TOKEN=     # PM-T-outbound-... from Postmark SMTP settings
# POSTMARK_SMTP_USERNAME=  # same PM-T-outbound-... value
# SMTP password on Render = your Server API Token OR same PM-T token per Postmark docs

# Feature approval reminders: GET or POST /api/feature-approval-reminders/run with X-Cron-Secret
# Falls back to NOTIFICATION_CRON_SECRET or CHECKLIST_CRON_SECRET if unset (see feature_approval_reminder_routes.py)
FEATURE_APPROVAL_CRON_SECRET=

# Pending escalation emails (cron-job.org / Render Cron / EasyCron):
# POST /api/escalation/send-pending-mails   — timeframe report (24–48 / 48–72 / 72hr+)
# POST /api/escalation/send-critical-mails  — critical 72hr+ only
# POST /api/escalation/send-stage-mails     — stage 2 / 3 / 4 pending (separate mail per enabled stage)
# Auth: Authorization: Bearer <secret>  OR  header X-Cron-Secret (same value)
ESCALATION_CRON_SECRET=

# cron-job.org — header X-Cron-Secret on GET /api/cron/run-all-emails (or per-module URLs)
FEATURE_APPROVAL_CRON_SECRET=your-secret-here

# ---------------------------------------------------------------------------
# Rate limiting (all optional — defaults shown; see backend/app/rate_limit.py)
# ---------------------------------------------------------------------------
# RATE_LIMIT_ENABLED=1                      # 0/false disables everything
# RATE_LIMIT_DEV_BYPASS=                    # 1 = skip per-IP limits (localhost is auto-skipped)
# Per-IP sliding windows:
# RATE_LIMIT_AUTH_WINDOW_SEC=60             # auth routes (login/register/reset) — strict
# RATE_LIMIT_AUTH_MAX_REQUESTS=20
# RATE_LIMIT_PUBLIC_WINDOW_SEC=60           # unauthenticated (no Bearer token) — moderate
# RATE_LIMIT_PUBLIC_MAX_REQUESTS=60
# RATE_LIMIT_GLOBAL_WINDOW_SEC=60           # authenticated user actions — looser
# RATE_LIMIT_GLOBAL_MAX_REQUESTS=150
# RATE_LIMIT_EXPENSIVE_WINDOW_SEC=60        # heavy aggregate endpoints
# RATE_LIMIT_EXPENSIVE_MAX_REQUESTS=30
# Per-account exponential backoff on auth routes (no hard lockout):
# RATE_LIMIT_AUTH_BACKOFF_FREE_ATTEMPTS=3   # attempts before delays start
# RATE_LIMIT_AUTH_BACKOFF_BASE_SEC=2        # first delay; doubles per attempt
# RATE_LIMIT_AUTH_BACKOFF_MAX_SEC=300       # delay cap (never locks out)
# RATE_LIMIT_AUTH_BACKOFF_FORGET_SEC=900    # idle time after which the counter resets
# ENABLE_DIAGNOSTIC_ENDPOINTS=0             # 1 = allow GET /check-user (user enumeration); keep off in prod

# ---------------------------------------------------------------------------
# Bot / 3rd-party agent protection (see app/bot_protect.py)
# ---------------------------------------------------------------------------
# ENV=production                            # or set on Render (auto-detected via RENDER_EXTERNAL_URL)
# DISABLE_OPENAPI=1                         # hide /docs /redoc /openapi.json (default on in prod)
# ENABLE_OPENAPI=0                          # set 1 only for temporary debugging
# ALLOW_PUBLIC_REGISTER=0                   # invite-only (default 0 in prod, 1 locally)
# TURNSTILE_SECRET_KEY=                     # Cloudflare Turnstile secret — when set, auth requires token
# TURNSTILE_DISABLED=0                      # 1 = skip Turnstile even if secret is set
# FMS_CLIENT_HEADER_REQUIRED=1              # require X-FMS-Client: web (default on in prod)
# FMS_CLIENT_HEADER_VALUE=web
# Cron reminder URLs (checklist/delegation/reminders/cron/…) are exempt — use X-Cron-Secret only.
# BOT_UA_BLOCK=1                            # block curl/httpx/bot UAs on auth + ticket/delegation writes (default on in prod)
# BOT_PROTECT_DEV_BYPASS=0                  # 1 = skip bot gates on all IPs (local debugging)
# BOT_PROTECT_FORCE=0                       # 1 = enforce bot gates even on localhost
# In-app honeypot + form timing (no Google/Cloudflare):
# AUTH_FORM_BOT_CHECKS=1                    # 0 = disable honeypot/timing
# AUTH_FORM_MIN_MS=800                      # reject submits faster than this
# AUTH_FORM_MAX_MS=7200000                  # reject stale forms (default 2h)
# AUTH_FORM_TIMING_REQUIRED=1               # prod: require form_opened_ms (default on in prod)
# BOT_STRIKE_ENABLED=1                      # count failed bot checks per account
# BOT_STRIKE_LIMIT=3                        # deactivate user after this many bot-check failures
# BOT_STRIKE_FORGET_SEC=86400               # reset strike counter after idle window

# Attendance sync: Industryprime_Attendance -> FMS to APPLICATION
# Run database/ATTENDANCE_SYNC_SYSTEM.sql in the FMS Supabase project first.
# Cron URL: GET or POST /api/cron/attendance-sync at 12:00 Asia/Kolkata with X-Cron-Secret.
ATTENDANCE_SOURCE_SUPABASE_URL=https://YOUR_ATTENDANCE_PROJECT_REF.supabase.co
ATTENDANCE_SOURCE_SERVICE_ROLE_KEY=your_attendance_source_service_role_key_here
ATTENDANCE_SYNC_TABLES=attendance_data,leave_requests
# Use a stable source id column, or a composite key like employee_id+attendance_date+punch_time.
ATTENDANCE_SYNC_KEY_COLUMNS=id,uuid,attendance_id,record_id
ATTENDANCE_SYNC_PAGE_SIZE=1000
ATTENDANCE_SYNC_CRON_SECRET=your-attendance-cron-secret
ATTENDANCE_SYNC_ATTENDANCE_TABLE=attendance_data
ATTENDANCE_SYNC_ATTENDANCE_EMPLOYEE_COLUMN=employee_id
ATTENDANCE_SYNC_EMPLOYEE_TABLE=employees
ATTENDANCE_SYNC_EMPLOYEE_ID_COLUMN=id
ATTENDANCE_SYNC_EMPLOYEE_NAME_COLUMNS=name,full_name,employee_name,display_name
