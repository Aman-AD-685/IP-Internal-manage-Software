# Baked into `vite build` (Vercel) so production always hits the real API.
# Override in Vercel → Settings → Environment Variables if your backend URL differs.
VITE_API_BASE_URL=https://ip-internal-manage-software.onrender.com
# PERF: turn ON section data prefetch (hover/idle warms the cache → instant page opens).
# Also add this in Vercel → Settings → Environment Variables so dashboard env doesn't override it.
VITE_ENABLE_ROUTE_DATA_PREFETCH=1
# Invite-only: hide Sign Up (backend ALLOW_PUBLIC_REGISTER=0)
VITE_ALLOW_PUBLIC_REGISTER=0
# Set in Vercel after creating a Cloudflare Turnstile widget (site key is public):
# VITE_TURNSTILE_SITE_KEY=
